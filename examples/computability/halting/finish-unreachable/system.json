{
  "system": "finish-unreachable",
  "title": "tick/finish with a deterministic scheduler that never proposes finish: unreachable at every prefix",
  "abstractions": [
    "policy",
    "tick",
    "finish"
  ],
  "types": {
    "Decision": {
      "list": "integer"
    },
    "Tick": {
      "record": {
        "k": "integer"
      }
    },
    "Finish": {
      "record": {
        "ticks": "integer"
      }
    }
  },
  "bindings": {
    "decisions": {
      "from": "policy",
      "select": "all",
      "type": "Decision",
      "note": "the recorded decisions: 0 tick, 1 finish"
    },
    "ticks": {
      "from": "tick",
      "select": "count",
      "note": "how many ticks are recorded"
    },
    "finishes": {
      "from": "finish",
      "select": "count",
      "note": "0 until finish is recorded"
    }
  },
  "plan": [
    {
      "phase": 1
    },
    {
      "phase": 2
    },
    {
      "phase": 3,
      "max_admissions": 40,
      "note": "a window of observation: 40 admissions"
    },
    {
      "kpi": true,
      "note": "execution indicators, once, at the end"
    }
  ],
  "expect": {
    "events": 50,
    "states": {
      "policy": "wait",
      "tick": "wait",
      "finish": "wait"
    },
    "values": {
      "finish": []
    },
    "any_schedule": {
      "note": "how the 40 admissions of the window divide between policy and tick depends on the schedule",
      "values": {
        "finish": []
      }
    }
  }
}
