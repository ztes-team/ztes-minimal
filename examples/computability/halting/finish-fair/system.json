        ],
        [
          0
        ],
        [
          1
        ]
      ],
      "finish": [
        {
          "ticks": 6
        }
      ]
    },
    "any_schedule": {
      "note": "policy waits until its last decision is acted on, so every abstraction has the history of the agenda under every schedule",
