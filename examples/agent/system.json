  "bindings": {
    "k": {
      "from": "$self",
      "select": "count",
      "note": "how many events this abstraction has"
    },
    "facts": {
      "from": "world",
      "select": "all",
      "type": "Fact",
      "note": "the recorded outside facts, in order"
    },
    "proposals": {
      "from": "propose",
      "select": "map",
      "type": "Proposal",
      "key": "x['t']",
      "value": "x['t']",
      "note": "the proposed tasks"
    },
    "ethics_v": {
      "from": "ethics",
      "select": "map",
      "type": "Verdict",
      "key": "x['t']",
      "value": "x['v']",
      "note": "task → the ethical verdict"
    },
    "energy_v": {
      "from": "energy",
      "select": "map",
      "type": "Energy",
      "key": "x['t']",
      "note": "task → the energy verdict, with the battery and the diesel it needs"
    },
    "ecology_v": {
      "from": "ecology",
      "select": "map",
      "type": "Ecology",
      "key": "x['t']",
      "note": "task → the ecological verdict, with the water and CO₂ of the day"
    },
    "decisions": {
      "from": "decide",
      "select": "map",
      "type": "Decision",
      "key": "x['t']",
      "value": "x['executed']",
      "note": "task → executed or not"
    },
    "comps": {
      "from": "compensate",
      "select": "map",
      "type": "Compensation",
      "key": "x['t']",
      "value": "x['m3']",
      "note": "task → the compensated overrun of water"
    }
  },
  "plan": [
    {
      "phase": 1
    },
    {
      "phase": 2
    },
    {
      "phase": 3,
      "note": "day 1, until terminal: no task of day 1 is left"
    },
    {
      "govern": [
        "ecology/criterion.v2",
        "ecology/ontology.v2",
        "propose/criterion.v2",
        "propose/ontology.v2"
      ],
      "note": "a drought: the water budget becomes 60 m³ a day; the agent turns to day 2"
    },
    {
      "phase": 3,
      "note": "day 2, until terminal"
    },
    {
      "kpi": true,
      "note": "execution indicators, once, at the end"
    }
  ],
  "expect": {
    "events": 85,
    "states": {
      "world": "wait",
