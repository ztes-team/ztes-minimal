{
  "system": "tsp",
  "title": "Exact travelling salesman by recorded subproblems (Held–Karp), reused across changes of the instance",
  "abstractions": ["dp", "tour"],
  "kpi": "kpi",
  "types": {
    "Entry": {"record": {"mask": "integer", "j": "integer", "cost": "integer", "pred": "integer"}},
    "Tour":  {"record": {"cities": {"list": "integer"}, "tour": {"list": "integer"}, "length": "integer"}},
    "Kpi":   {"record": {"profile": "integer", "questions": "integer", "subproblems": "integer", "needed": "integer",
                         "saved": "integer", "tour_invocations": "integer", "tour_not_yet": "integer"}}
  },
  "constants": {
    "XY": [[0, 0], [2, 7], [8, 3], [5, 9], [9, 9], [1, 4], [7, 6], [4, 1]]
  },
  "derived": {
    "D": "matrix(XY, N)",
    "ORDER": "order(N)"
  },
  "bindings": {
    "done":  {"from": "dp", "select": "count",
              "note": "how many subproblems are recorded"},
    "cost":  {"from": "dp", "select": "map", "type": "Entry", "key": "(x['mask'], x['j'])", "value": "x['cost']",
              "note": "the memo table: (S, j) → recorded cost"},
    "entry": {"from": "dp", "select": "map", "type": "Entry", "key": "(x['mask'], x['j'])",
              "note": "(S, j) → the whole recorded subproblem"},
    "tours": {"from": "tour", "select": "all", "type": "Tour",
              "note": "the questions already answered"}
  },
  "plan": [
    {"phase": 1},
    {"phase": 2},
    {"phase": 3, "note": "instance 1: the optimal tour through cities 0–6"},
    {"govern": ["dp/criterion.v2", "dp/ontology.v2", "tour/criterion.v2", "tour/ontology.v2"],
     "note": "instance 2: city 7 is added; the recorded subproblems over cities 0–6 stay valid"},
    {"phase": 3},
    {"govern": ["tour/criterion.v3", "tour/ontology.v3"],
     "note": "instance 3: a tour through cities 0, 1, 2, 3, 5, 7 only; every subproblem it needs is recorded"},
    {"phase": 3},
    {"kpi": true, "note": "execution indicators, once, at the end"}
  ],
  "expect": {
    "events": 468,
    "states": {"dp": "wait", "tour": "wait"},
    "values": {
      "tour": [
        {"cities": [0, 1, 2, 3, 4, 5, 6], "tour": [0, 5, 1, 3, 4, 6, 2, 0], "length": 38},
        {"cities": [0, 1, 2, 3, 4, 5, 6, 7], "tour": [0, 7, 2, 6, 4, 3, 1, 5, 0], "length": 38},
        {"cities": [0, 1, 2, 3, 5, 7], "tour": [0, 7, 2, 3, 1, 5, 0], "length": 34}
      ]
    }
  }
}
