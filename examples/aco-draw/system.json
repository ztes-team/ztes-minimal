{
  "system": "aco-draw",
  "title": "Ant colony optimization with the classical random rule: every draw is a recorded event",
  "abstractions": ["draw", "tour", "best"],
  "kpi": "kpi",
  "sources": {"draw": {"random": {"seed": 1, "size": 11, "below": 1000000}}},
  "types": {
    "Draw": {"list": "integer"},
    "Tour": {"record": {"k": "integer", "walk": {"list": "integer"}, "length": "integer"}},
    "Kpi":  {"record": {"profile": "integer", "tours": "integer", "distinct": "integer", "best": "integer",
                        "found_by_ant": "integer", "optimum": "integer", "gap_permille": "integer",
                        "tour_invocations": "integer", "best_not_yet": "integer"}}
  },
  "constants": {
    "XY": [[0, 0], [2, 7], [8, 3], [5, 9], [9, 9], [1, 4], [7, 6], [4, 1], [3, 3], [6, 8], [9, 1], [0, 9]],
    "N": 12,
    "K": 12,
    "BETA": 2,
    "T": 60,
    "M": 1000000,
    "OPT": 50
  },
  "derived": {"D": "matrix(XY, N)"},
  "bindings": {
    "draws": {"from": "draw", "select": "count", "note": "draws already admitted"},
    "rolls": {"from": "draw", "select": "all", "type": "Draw", "note": "the recorded draws; ant k uses draw k"},
    "k":     {"from": "tour", "select": "count", "note": "the number of the next ant"},
    "trail": {"from": "tour", "select": "all", "type": "Tour", "window": "K",
              "note": "evaporation: an ant reads the last K tours; older ones stay in C and are not read"},
    "tours": {"from": "tour", "select": "all", "type": "Tour"},
    "best":  {"from": "best", "select": "last", "type": "Tour",
              "default": {"k": -1, "walk": [], "length": 1000000000}}
  },
  "plan": [
    {"phase": 1},
    {"phase": 2},
    {"phase": 3, "note": "T draws and T ants; each ant reads the trail left by the K before it"},
    {"kpi": true, "note": "execution indicators, once, at the end"}
  ],
  "expect": {
    "events": 138,
    "states": {"draw": "closed", "tour": "wait", "best": "wait"},
    "values": {"kpi": [{"profile": 1, "tours": 60, "distinct": 60, "best": 54, "found_by_ant": 52, "optimum": 50, "gap_permille": 80, "tour_invocations": 61, "best_not_yet": 28}]},
    "any_schedule": {
      "note": "how often best is invoked between two tours decides how many improvements it records",
      "last": {"best": {"length": 54}}
    }
  }
}
