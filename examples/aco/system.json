{
  "system": "aco",
  "title": "Ant colony optimization in its natural form: the trail is the record, a quota replaces the draw",
  "abstractions": ["tour", "best"],
  "kpi": "kpi",
  "types": {
    "Tour": {"record": {"k": "integer", "walk": {"list": "integer"}, "length": "integer"}},
    "Kpi":  {"record": {"profile": "integer", "tours": "integer", "distinct": "integer", "best": "integer",
                        "found_by_ant": "integer", "optimum": "integer", "gap_permille": "integer",
                        "tour_invocations": "integer", "best_not_yet": "integer"}}
  },
  "constants": {
    "XY": [[0, 0], [2, 7], [8, 3], [5, 9], [9, 9], [1, 4], [7, 6], [4, 1], [3, 3], [6, 8], [9, 1], [0, 9]],
    "N": 12,
    "K": 12,
    "BETA": 2,
    "T": 60,
    "OPT": 50
  },
  "derived": {"D": "matrix(XY, N)"},
  "bindings": {
    "k":     {"from": "tour", "select": "count", "note": "the number of the next ant"},
    "trail": {"from": "tour", "select": "all", "type": "Tour", "window": "K",
              "note": "evaporation: an ant reads the last K tours; older ones stay in C and are not read"},
    "tours": {"from": "tour", "select": "all", "type": "Tour"},
    "best":  {"from": "best", "select": "last", "type": "Tour",
              "default": {"k": -1, "walk": [], "length": 1000000000}}
  },
  "plan": [
    {"phase": 1},
    {"phase": 2},
    {"phase": 3, "note": "T ants, one after another; each reads the trail left by the K before it"},
    {"kpi": true, "note": "execution indicators, once, at the end"}
  ],
  "expect": {
    "events": 73,
    "states": {"tour": "closed", "best": "wait"},
    "values": {"kpi": [{"profile": 1, "tours": 60, "distinct": 58, "best": 52, "found_by_ant": 36, "optimum": 50, "gap_permille": 40, "tour_invocations": 61, "best_not_yet": 30}]}
  }
}
